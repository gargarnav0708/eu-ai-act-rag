# EU AI Act RAG Assistant configuration
# Keep HF_TOKEN blank unless you choose to use an environment token directly.
# For gated Meta Llama 3 access, run `hf auth login` after obtaining model access.
HF_TOKEN=

# Paths are relative to the project root unless you provide absolute paths.
EU_AI_ACT_PDF=data/EU_AI_Act.pdf
CHROMA_DIR=storage/chroma
CHUNKS_PATH=storage/chunks.jsonl
EVAL_PATH=data/eval_questions.json

# Model IDs
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
COLLECTION_NAME=eu_ai_act_v1

# Retrieval and chunking settings
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
VECTOR_CANDIDATES=20
BM25_CANDIDATES=20
RERANK_CANDIDATES=12
FINAL_K=5

# Use cpu for a laptop-first retrieval build; set to cuda for a supported NVIDIA GPU.
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
